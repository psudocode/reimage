{
  "name": "reimage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "All-in-one image tools in your browser. No uploads, no sign-up, no limits.",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "comlink": "^4.4.2",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.1",
    "pica": "^9.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@size-limit/file": "^11.2.0",
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/pica": "^9.0.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.2",
    "vitest": "^3.1.1"
  },
  "size-limit": [
    {
      "name": "Initial JS bundle",
      "path": "dist/assets/{index,Panel}-*.js",
      "limit": "150 kB",
      "gzip": true
    }
  ]
}
